

# Database Connection (Neon PostgreSQL in production; leave unset for local SQLite fallback)
# Example: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL=

# Django Secret Key (required in production; generate via: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())')
DJANGO_SECRET_KEY=
SECRET_KEY=

# Debug Mode (set to False in production, True for local development)
DEBUG=True

# Allowed Hosts (comma-separated list of hostnames; automatically includes .vercel.app on Vercel)
ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app

# CSRF Trusted Origins (comma-separated list including https:// protocol)
CSRF_TRUSTED_ORIGINS=https://*.vercel.app

# Restricted Reviewer Access Mode (set to True to require login for all sales viewing & recording)
RESTRICTED_ACCESS=False

# Reviewer User Credentials (used by 'python manage.py setup_db' / 'python manage.py ensure_reviewer')
# Set a strong, private password for reviewer access
REVIEWER_USERNAME=reviewer
REVIEWER_PASSWORD=
REVIEWER_EMAIL=reviewer@example.com
